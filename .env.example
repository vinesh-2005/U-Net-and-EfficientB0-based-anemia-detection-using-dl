# ====================================================================
# ANEMEIA — Environment Configuration Template
# Copy this file to .env and configure your MySQL credentials:
# cp .env.example .env
# ====================================================================

# Flask Application Secret Key (replace with a random secure string in production)
SECRET_KEY=anemeia-secure-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anemeia_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Optional: Fallback to SQLite if MySQL is unavailable (true/false)
# Useful for local testing and demonstration when MySQL server is not installed
DB_FALLBACK_SQLITE=false
